# Systemd unit for the Quant Strategy Control Centre backend.
#
# This file is written/refreshed automatically by deploy/deploy-ec2.sh (it is
# shipped inside the release artifact); the paths below are rewritten to
# $APP_DIR at install time. All configuration is REAL environment variables —
# no .env file is needed (the Settings layer reads env vars first and treats
# platform/backend/.env as an optional dev convenience). AWS access comes from
# the EC2 IAM role (golden rule 7); the admin token lives in the env file
# below, never in this world-readable unit.
#
# Manual install (bootstrap):
#   sudo cp deploy/systemd/quant-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now quant-backend
#
# The paths below use the default install root /opt/quant-control-centre (the
# repo name, "centre" spelling). Set PLATFORM_ROOT to the same value.

[Unit]
Description=Quant Strategy Control Centre backend
After=network-online.target
Wants=network-online.target
# Stop restart-storming: after 5 failed starts within a minute the unit stays
# failed (a broken dependency must not spin 600+ times).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant-control-centre/platform/backend
ExecStart=/opt/quant-control-centre/platform/backend/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 --port 8000 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
# --proxy-headers: behind a TLS-terminating reverse proxy (nginx), uvicorn sees
# plain http; honouring X-Forwarded-Proto keeps HTTPS_REQUIRED=true working.
# Restrict --forwarded-allow-ips to the proxy's address only.

# --- Configuration: real environment variables -------------------------
# The admin token (and any other secret) lives in this 640 root:quant file,
# never in this unit. deploy-ec2.sh creates it on the first deploy with a
# generated token:  sudo cat /etc/quant/backend.env
EnvironmentFile=-/etc/quant/backend.env

Environment=ENVIRONMENT=production
Environment=AWS_REGION=ap-south-1
Environment=S3_BUCKET=quant-platform-prod
# Addressing style defaults to "auto" (virtual-hosted for real AWS).
# No AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: the EC2 IAM role provides them.
# S3_ENDPOINT_URL is LOCAL-ONLY (LocalStack): leaving it set while
# ENVIRONMENT=production is refused at startup.

# Platform filesystem layout. Point strategies at a dedicated data volume,
# outside the platform code tree, owned by the `quant` user.
Environment=PLATFORM_ROOT=/opt/quant-control-centre
Environment=STRATEGIES_DIR=/var/lib/quant-control-centre/strategies

# Scheduler: install cron entries for real. The cron-fired runner gets its
# environment from cron itself (e.g. /etc/environment or per-line assignments
# in the crontab) — this unit's environment is NOT inherited by cron jobs.
Environment=SCHEDULER_DRY_RUN=false

# Auth + HTTPS: enforced behind the reverse proxy.
Environment=AUTH_ENABLED=true
Environment=HTTPS_REQUIRED=true

Environment=LOG_LEVEL=INFO
# The strategy venvs are created by the service itself, so it must be able to
# find the pyenv shims (python3.14) — systemd services do NOT inherit a login
# shell's PATH. The deploy script rewrites the install-root part of this line.
Environment=PATH=/opt/pyenv/shims:/opt/quant-control-centre/platform/backend/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYENV_ROOT=/opt/pyenv
# Python version used for the per-strategy venvs. Broker SDKs (fyers-apiv3,
# dhanhq) pin dependencies whose wheels only exist for the older versions —
# on 3.14 pip would build aiohttp from source (slow, often failing).
Environment=DEFAULT_PYTHON_VERSION=3.12

# Hardening (optional but sensible for a trading platform).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quant-control-centre /opt/quant-control-centre/runtime
PrivateTmp=true

[Install]
WantedBy=multi-user.target
