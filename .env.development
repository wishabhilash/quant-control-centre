# Local development configuration (spec section 17).
# Use a separate development bucket and a local S3-compatible store (LocalStack).
# NEVER point this at production strategy documents.

ENVIRONMENT=development
AWS_REGION=ap-south-1
S3_BUCKET=quant-platform-dev

# LocalStack S3 endpoint (default port 4566).
S3_ENDPOINT_URL=http://localhost:4566
S3_USE_SSL=false
# LocalStack requires path-style addressing; "auto" selects it for a custom endpoint.
S3_ADDRESSING_STYLE=path

# LocalStack's default credentials. These are ONLY for local LocalStack.
# On EC2 these are absent and the EC2 IAM role is used instead.
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=testpass

# Auth is disabled in dev; enable a dev token if you expose the API.
AUTH_ENABLED=false
DEV_API_TOKEN=

# Scheduler writes a platform-owned crontab file but does NOT install it into
# the system crontab, so testing never touches a Mac's crontab.
SCHEDULER_DRY_RUN=true

LOG_LEVEL=INFO

# Where strategy projects, venvs, runtime state, locks and logs live.
# On EC2 this is /opt/quant (spec 4). Locally, point it at a WRITABLE
# dir (e.g. this repo root) — otherwise delete/deploy/start/stop/logs
# fail with a PermissionError because /opt/quant does not exist on a laptop.
# PLATFORM_ROOT=/opt/quant
