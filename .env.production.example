# Production configuration (spec sections 16, 17).
# On EC2, AWS credentials come from the EC2 IAM role, so they are NOT set here.

ENVIRONMENT=production
AWS_REGION=ap-south-1
S3_BUCKET=quant-platform-prod
S3_ENDPOINT_URL=
S3_USE_SSL=true
# Leave S3_ADDRESSING_STYLE unset ("auto") in production => virtual-host style for real AWS S3.

# Enforce HTTPS and authenticate admin sessions in production.
AUTH_ENABLED=true
HTTPS_REQUIRED=true

# Install the generated crontab into the system crontab on EC2.
SCHEDULER_DRY_RUN=false

LOG_LEVEL=INFO
# PLATFORM_ROOT=/opt/quant
