# Production configuration (spec sections 16, 17).
# On EC2, AWS credentials come from the EC2 IAM role, so they are NOT set here.

ENVIRONMENT=production
AWS_REGION=ap-south-1
S3_BUCKET=quant-platform-prod
# S3_ENDPOINT_URL / S3_USE_SSL are LOCAL-ONLY (LocalStack) settings: production
# talks to real AWS S3 over TLS via the EC2 IAM role. Leave S3_ENDPOINT_URL
# unset (the platform refuses to start if it is set while ENVIRONMENT=production)
# and leave S3_ADDRESSING_STYLE unset ("auto" => virtual-host style for AWS).

# Enforce HTTPS and authenticate admin sessions in production.
AUTH_ENABLED=true
HTTPS_REQUIRED=true

# Install the generated crontab into the system crontab on EC2.
SCHEDULER_DRY_RUN=false

LOG_LEVEL=INFO
# PLATFORM_ROOT=/opt/quant

# Where strategy projects, venvs and runner logs live. On EC2 the spec §4
# default is {PLATFORM_ROOT}/strategies, but on a server deployment point this
# at a DEDICATED data volume (kept outside the platform code tree) so a
# platform redeploy can never touch strategy data. The platform refuses to
# manage a directory that exists without its `.quant-managed` ownership marker,
# so a misconfigured path fails fast instead of overwriting existing strategies.
# STRATEGIES_DIR=/var/lib/quant/strategies
